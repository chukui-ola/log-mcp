        "-o", "PreferredAuthentications=publickey",
        "-o", "StrictHostKeyChecking=no"
      ]
    },
    {
      "id": "dev-192-168-1-28",
      "type": "ssh",
      "ssh_target": "jenkins@192.168.1.28",
      "ssh_options": [
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=5",
        "-o", "ConnectionAttempts=1",
        "-o", "NumberOfPasswordPrompts=0",
        "-o", "PreferredAuthentications=publickey",
        "-o", "StrictHostKeyChecking=no"
      ]
